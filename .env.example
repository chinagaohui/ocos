# OpenClaw 小说智能写作系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 必填 ====================

# API 认证 Token（请求时通过 X-API-Key Header 传递）
OPENCLAW_API_TOKEN=your-secret-api-token-here

# ==================== LLM 配置（至少配一组） ====================

# ── 使用方式 ──────────────────────────────────────────
# 1. 选择一个云端模型，取消下方对应 API_KEY 的注释并填入密钥
# 2. 修改 config/environments/development.toml 中的
#    [llm_gateway] default_client = "deepseek"（或 "openai"/"anthropic"）
# 3. 重启系统即可
#
# 推荐（中文写作性价比）：
#   DeepSeek = deepseek-chat  (¥2/百万token，中文极佳)
#   OpenAI   = gpt-4o-mini    (经济型)
#   Anthropic = claude-3-5-sonnet (英文最佳，适合翻译场景)
# ──────────────────────────────────────────────────────

# [Ollama] 本地 LLM（默认使用，无需 API Key）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# [DeepSeek] 推荐！国产最强性价比，中文写作首选
# 注册: https://platform.deepseek.com/  → API Keys → 创建
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# [MiMo] 小米 MiMo-v2.5-pro，1M 上下文窗口，中文写作极佳
# MIMO_API_KEY=tp-your-mimo-token

# [OpenAI] 通用云端模型
# 注册: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key

# [Anthropic Claude] 英文能力强，适合翻译/润色场景
# 注册: https://console.anthropic.com/ → API Keys
# ANTHROPIC_API_KEY=sk-ant-your-key

# ==================== 可选 ====================

# 日志级别（DEBUG / INFO / WARNING / ERROR）
# LOG_LEVEL=INFO

# 项目数据目录（默认 projects/）
# PROJECTS_DIR=projects

# 监听地址和端口（默认 0.0.0.0:3001）
# HOST=0.0.0.0
# PORT=3001

# ChromaDB 持久化路径（默认 chroma_data/）
# CHROMA_PERSIST_DIR=chroma_data

# 缓存 TTL（秒，默认 3600）
# CACHE_TTL=3600

# 最大并发 LLM 请求数（默认 3）
# MAX_CONCURRENT_LLM=3
